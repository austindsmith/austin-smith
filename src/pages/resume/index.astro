---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

const hasPdf = false;
---

<Layout title={`Resume | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <div class="archive-hero" data-archive-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-archive-mouse></div>
      <div class="relative z-10 flex items-start justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
            <span class="glow-text">Resume</span>
          </h1>
          <p class="mt-3 max-w-lg text-foreground/70 italic">
            Current as of {new Date().getFullYear()}.
          </p>
        </div>
        {hasPdf && (
          <a href="/resume.pdf" download="austin-resume.pdf" class="resume-download-btn mt-1 shrink-0">
            Download PDF
          </a>
        )}
      </div>
    </div>

    <div class="mt-8 max-w-app">
      {hasPdf ? (
        <div class="resume-embed-wrapper rounded-2xl border border-border/25 overflow-hidden">
          <embed
            src="/resume.pdf"
            type="application/pdf"
            class="resume-embed"
            title="Resume"
          />
        </div>
      ) : (
        <div class="resume-placeholder rounded-2xl border border-border/25 border-dashed">
          <p class="text-foreground/40 text-sm">Resume coming soon.</p>
        </div>
      )}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .resume-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--background);
    background: var(--accent);
    border-radius: 0.625rem;
    transition: all 0.2s ease;
  }

  .resume-download-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .resume-embed-wrapper {
    background: color-mix(in srgb, var(--muted) 30%, transparent);
  }

  .resume-embed {
    display: block;
    width: 100%;
    height: 85vh;
    min-height: 600px;
  }

  .resume-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 400px;
    background: color-mix(in srgb, var(--muted) 20%, transparent);
  }
</style>